<?xml version="1.0" encoding="UTF-8"?>
<!--
    SAML extraction profile "orders-api". Runs when the calling proxy
    sets saml.extract.profile = "orders-api" before invoking this
    shared flow (see default.xml). local-name() makes every XPath
    namespace-prefix-agnostic, so it doesn't matter whether the IdP
    emits saml2:, saml:, or no prefix at all.

    IgnoreUnresolvedVariables is true here because sessionIndex is
    genuinely optional in this example; set it false for a claim a
    profile requires — a missing required claim then fails loudly
    instead of silently signing a JWT with a blank "sub".

    To add a new profile: copy this policy, give it a new name/XPath
    set, add a Step for it in default.xml gated on
    saml.extract.profile = "<new profile>", and add that profile to
    RF-Unsupported-SAML-Extract-Profile's Condition.
-->
<ExtractVariables name="EV-Extract-SAML-orders-api">
    <DisplayName>EV-Extract-SAML-orders-api</DisplayName>
    <Source>saml.assertion.xml</Source>
    <XMLPayload>
        <Variable name="saml.subject" type="string">
            <XPath>//*[local-name()='Subject']/*[local-name()='NameID']/text()</XPath>
        </Variable>
        <Variable name="saml.email" type="string">
            <XPath>//*[local-name()='Attribute'][@Name='email']/*[local-name()='AttributeValue']/text()</XPath>
        </Variable>
        <Variable name="saml.sessionIndex" type="string">
            <XPath>//*[local-name()='AuthnStatement']/@SessionIndex</XPath>
        </Variable>
    </XMLPayload>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</ExtractVariables>
