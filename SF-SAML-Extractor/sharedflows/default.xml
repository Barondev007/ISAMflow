<?xml version="1.0" encoding="UTF-8"?>
<SharedFlow name="default">

    <!-- ================================================================
         Reads the SAML assertion from the configured request header
         (saml.header.name, default "X-SAML-Assertion" if the calling
         proxy hasn't set it — raw XML or base64-encoded, auto-detected)
         and exposes it as saml.assertion.xml.

         Call this shared flow, then run a native ExtractVariables
         policy in the calling proxy with <Source>saml.assertion.xml</Source>
         and proxy-specific XPath (using local-name() to ignore
         namespace prefixes) to pull out whatever elements that proxy
         needs — see examples/orders-api-proxy/apiproxy/policies/
         EV-Extract-SAML-Claims.xml. Extraction is deliberately left to
         each proxy rather than driven by a shared config: XPath is
         static per policy in Apigee, so a proxy that already knows its
         own SAML shape is simpler served by its own ExtractVariables
         policy than by a generic KVM-driven engine.
         ================================================================ -->
    <Step>
        <Name>JS-Decode-SAML-Assertion</Name>
    </Step>

</SharedFlow>
