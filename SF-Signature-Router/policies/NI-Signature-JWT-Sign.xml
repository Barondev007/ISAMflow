<?xml version="1.0" encoding="UTF-8"?>
<!--
    Placeholder for the remaining JWT sub-step: send
    signature.jwt.signing.string to the external signature API and take
    back the signature value. Replace this policy with a ServiceCallout
    (+ AssignMessage) chain when the signing API contract is defined —
    it must set signature.jwt.signature.encoded (the signature,
    base64url-encoded with no padding) before AM-JWT-Assemble-JWS-Compact
    / -Detached run, which assemble the final JWS from it.
-->
<RaiseFault name="NI-Signature-JWT-Sign">
    <DisplayName>NI-Signature-JWT-Sign</DisplayName>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <FaultResponse>
        <Set>
            <StatusCode>501</StatusCode>
            <ReasonPhrase>Not Implemented</ReasonPhrase>
            <Payload contentType="application/json">{
    "error": "not_implemented",
    "message": "JWT signing string built successfully but the call to the signature API is not implemented yet.",
    "signingString": "{signature.jwt.signing.string}"
}</Payload>
        </Set>
    </FaultResponse>
</RaiseFault>
