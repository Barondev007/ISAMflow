<?xml version="1.0" encoding="UTF-8"?>
<!--
    Placeholder for the remaining XML-DSig sub-step: send
    signature.xmldsig.signing.string (base64 of the canonicalized
    SignedInfo) to the external signature API and take back the
    signature value. Replace this policy with a ServiceCallout (+
    AssignMessage) chain when the signing API contract is defined — it
    must set signature.xmldsig.signatureValue (the signature, base64
    encoded — XML-DSig's SignatureValue is plain base64, unlike JWT's
    base64url) before JC-Assemble-XmlDsig-Signature runs, which embeds it
    — together with this proxy's KVM-configured X.509 certificate — into
    the final <Signature> and splices it into the document. Same
    contract shape as NI-Signature-JWT-Sign/signature.jwt.signature.encoded.
-->
<RaiseFault name="NI-Signature-XmlDsig-Sign">
    <DisplayName>NI-Signature-XmlDsig-Sign</DisplayName>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <FaultResponse>
        <Set>
            <StatusCode>501</StatusCode>
            <ReasonPhrase>Not Implemented</ReasonPhrase>
            <Payload contentType="application/json">{
    "error": "not_implemented",
    "message": "XML-DSig SignedInfo built successfully but the call to the signature API is not implemented yet.",
    "digestValue": "{signature.xmldsig.digest.value}",
    "signingString": "{signature.xmldsig.signing.string}"
}</Payload>
        </Set>
    </FaultResponse>
</RaiseFault>
