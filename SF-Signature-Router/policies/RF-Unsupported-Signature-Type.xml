<?xml version="1.0" encoding="UTF-8"?>
<RaiseFault name="RF-Unsupported-Signature-Type">
    <DisplayName>RF-Unsupported-Signature-Type</DisplayName>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <FaultResponse>
        <Set>
            <StatusCode>500</StatusCode>
            <ReasonPhrase>Internal Server Error</ReasonPhrase>
            <Payload contentType="application/json">{
    "error": "configuration_error",
    "message": "Unsupported signature.type '{signature.type}'. Supported values: jwt, xmldsig, cavage."
}</Payload>
        </Set>
    </FaultResponse>
</RaiseFault>
