<?xml version="1.0" encoding="UTF-8"?>
<SharedFlowBundle name="SF-Signature-Router">
    <ConfigurationVersion majorVersion="4" minorVersion="0"/>
    <DisplayName>SF-Signature-Router</DisplayName>
    <Description>
        Single entry point for message signing. Calling API proxies set the
        signature.type flow variable (jwt | xmldsig | cavage) and invoke this
        shared flow via FlowCallout; it routes to the matching sub-step.
    </Description>
    <Policies>
        <Policy>RF-Missing-Signature-Type</Policy>
        <Policy>RF-Unsupported-Signature-Type</Policy>
        <Policy>AM-JWT-Set-KVM-Key</Policy>
        <Policy>KVM-Get-JWT-Header-Template</Policy>
        <Policy>RF-JWT-Header-Config-Missing</Policy>
        <Policy>JS-Build-JWT-Signing-String</Policy>
        <Policy>NI-Signature-JWT-Sign</Policy>
        <Policy>NI-Signature-XMLDSig</Policy>
        <Policy>AM-Cavage-Set-KVM-Key</Policy>
        <Policy>KVM-Get-Cavage-Headers-Template</Policy>
        <Policy>RF-Cavage-Headers-Config-Missing</Policy>
        <Policy>JS-Build-Cavage-Signing-String</Policy>
        <Policy>NI-Signature-Cavage-Sign</Policy>
    </Policies>
    <SharedFlows>
        <SharedFlow>default</SharedFlow>
    </SharedFlows>
</SharedFlowBundle>
