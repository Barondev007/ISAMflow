<?xml version="1.0" encoding="UTF-8"?>
<SharedFlow name="default">

    <!-- ================================================================
         Guard: the calling API proxy must set signature.type before
         invoking this shared flow (e.g. via AssignMessage, then
         FlowCallout with SharedFlowBundle="SF-Signature-Router").
         ================================================================ -->
    <Step>
        <Name>RF-Missing-Signature-Type</Name>
        <Condition>signature.type = null</Condition>
    </Step>

    <!-- ================================================================
         1) JWT Signature
         Builds the JOSE header from the shared KVM "signature" (entry
         key "{apiproxy.name}.jwt.header") and produces the signing
         string base64url(header) + "." + base64url(payload).
         TODO: NI-Signature-JWT-Sign still needs to call the signing API
         and set signature.jwt.signature.encoded. Once it does,
         AM-JWT-Assemble-JWS-Compact / -Detached assemble the final JWS
         into signature.jwt.jws — compact (header.payload.signature) by
         default, or detached (header..signature) when the calling
         proxy sets signature.jwt.detached to the STRING "true" (not the
         boolean literal — see AM-JWT-Assemble-JWS-Detached). Leave the
         Condition on each step unchanged.
         ================================================================ -->
    <Step>
        <Name>AM-JWT-Set-KVM-Key</Name>
        <Condition>signature.type = "jwt"</Condition>
    </Step>
    <Step>
        <Name>KVM-Get-JWT-Header-Template</Name>
        <Condition>signature.type = "jwt"</Condition>
    </Step>
    <Step>
        <Name>RF-JWT-Header-Config-Missing</Name>
        <Condition>signature.type = "jwt" AND signature.jwt.header.template = null</Condition>
    </Step>
    <Step>
        <Name>JS-Build-JWT-Signing-String</Name>
        <Condition>signature.type = "jwt"</Condition>
    </Step>
    <Step>
        <Name>NI-Signature-JWT-Sign</Name>
        <Condition>signature.type = "jwt"</Condition>
    </Step>
    <Step>
        <Name>AM-JWT-Assemble-JWS-Detached</Name>
        <Condition>signature.type = "jwt" AND signature.jwt.detached = "true"</Condition>
    </Step>
    <Step>
        <Name>AM-JWT-Assemble-JWS-Compact</Name>
        <Condition>signature.type = "jwt" AND signature.jwt.detached != "true"</Condition>
    </Step>

    <!-- ================================================================
         2) XML Signature (XML-DSig)
         TODO: replace NI-Signature-XMLDSig with the real sub-step
         policy chain. Leave the Condition unchanged.
         ================================================================ -->
    <Step>
        <Name>NI-Signature-XMLDSig</Name>
        <Condition>signature.type = "xmldsig"</Condition>
    </Step>

    <!-- ================================================================
         3) HTTP Signature (Cavage / draft-cavage-http-signatures)
         Builds the signing string from the current request and the
         shared KVM "signature" (entry key
         "{apiproxy.name}.cavage.headers"): one "name: value" line per
         configured header, joined by "\n".
         TODO: NI-Signature-Cavage-Sign still needs to call the signing
         API and assemble the Signature/Authorization header. Leave the
         Condition on each step unchanged.
         ================================================================ -->
    <Step>
        <Name>AM-Cavage-Set-KVM-Key</Name>
        <Condition>signature.type = "cavage"</Condition>
    </Step>
    <Step>
        <Name>KVM-Get-Cavage-Headers-Template</Name>
        <Condition>signature.type = "cavage"</Condition>
    </Step>
    <Step>
        <Name>RF-Cavage-Headers-Config-Missing</Name>
        <Condition>signature.type = "cavage" AND signature.cavage.headers.template = null</Condition>
    </Step>
    <Step>
        <Name>JS-Build-Cavage-Signing-String</Name>
        <Condition>signature.type = "cavage"</Condition>
    </Step>
    <Step>
        <Name>NI-Signature-Cavage-Sign</Name>
        <Condition>signature.type = "cavage"</Condition>
    </Step>

    <!-- ================================================================
         Guard: reject anything that isn't one of the three known types.
         ================================================================ -->
    <Step>
        <Name>RF-Unsupported-Signature-Type</Name>
        <Condition>signature.type != "jwt" AND signature.type != "xmldsig" AND signature.type != "cavage"</Condition>
    </Step>

</SharedFlow>
