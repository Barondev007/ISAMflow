<?xml version="1.0" encoding="UTF-8"?>
<!--
    Same pattern as SF-Signature-Router's AM-JWT-Set-KVM-Key: the KVM
    name itself must be static ("signature"), so per-proxy config lives
    on the entry key instead: "{apiproxy.name}.jwt.verify".
-->
<AssignMessage name="AM-JWT-Verify-Set-KVM-Key">
    <DisplayName>AM-JWT-Verify-Set-KVM-Key</DisplayName>
    <AssignVariable>
        <Name>signature.kvm.key</Name>
        <Template>{apiproxy.name}.jwt.verify</Template>
    </AssignVariable>
    <IgnoreUnresolvedVariables>false</IgnoreUnresolvedVariables>
</AssignMessage>
