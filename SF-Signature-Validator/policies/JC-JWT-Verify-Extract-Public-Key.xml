<?xml version="1.0" encoding="UTF-8"?>
<!--
    Extracts the public key from this proxy's configured KeyStore
    certificate (KeyStore/Alias resolved from KVM — see
    EV-JWT-Verify-Parse-Config.xml, same source as before) and writes it as
    PEM text into signature.verify.jwt.publicKey.pem. Needed because
    VerifyJWS's own <PublicKey><KeyStore ref="..."/><Alias ref="..."/></PublicKey>
    does NOT resolve a dynamic ref at runtime (confirmed against a live
    Apigee instance) — only ServiceCallout/TargetEndpoint's
    <SSLInfo><KeyStore ref="..."> does that. Apigee has no native policy
    and JS can't reach KeyStore key material, so this one piece is a
    compiled JavaCallout — see java-src/README.md for build/deploy steps,
    and the class-level comment in
    java-src/.../PublicKeyFromKeystoreCallout.java for the one line
    (the actual KeyStore lookup call) that's unverified against Apigee's
    real Java Callout SDK and needs your own confirmation when you build
    it.

    continueOnError is deliberately false: if the keystore/alias/lookup is
    misconfigured or the KeyStore truly has no such certificate, failing
    the request here (before ever reaching VerifyJWS) is correct —
    VerifyJWS-Jwt-Compact/-Detached would otherwise either fail on a null
    PublicKey or, worse, silently fall through to Source without one.
-->
<JavaCallout name="JC-JWT-Verify-Extract-Public-Key">
    <DisplayName>JC-JWT-Verify-Extract-Public-Key</DisplayName>
    <ClassName>com.orders.signature.PublicKeyFromKeystoreCallout</ClassName>
    <ResourceURL>java://signature-keystore-callout.jar</ResourceURL>
    <Properties>
        <Property name="keystore-name">{signature.verify.jwt.keystore.name}</Property>
        <Property name="alias">{signature.verify.jwt.keystore.alias}</Property>
        <Property name="output-variable">signature.verify.jwt.publicKey.pem</Property>
    </Properties>
</JavaCallout>
