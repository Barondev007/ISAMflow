<?xml version="1.0" encoding="UTF-8"?>
<!--
    Reads "kid" (and "alg", for the record) out of the JWS header,
    WITHOUT verifying anything — just enough to know which key to look
    up in the JWKS document before VerifyJWS can run. Only runs when
    this proxy's KVM config has no publicKeyPem (i.e. is JWKS-based —
    see EV-JWT-Verify-Parse-Config); the static-PEM path never needs a
    "kid" at all.
-->
<Javascript name="JS-JWT-Verify-Extract-Kid" timeLimit="200">
    <DisplayName>JS-JWT-Verify-Extract-Kid</DisplayName>
    <ResourceURL>jsc://jwt-verify-extract-kid.js</ResourceURL>
</Javascript>
