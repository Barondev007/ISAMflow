<?xml version="1.0" encoding="UTF-8"?>
<!--
    Finds the JWKS entry matching signature.verify.jwt.header.kid and
    repackages its RSA modulus/exponent as a PEM SubjectPublicKeyInfo
    into signature.verify.jwt.publicKey.pem — see the class-level
    comment in jwt-verify-resolve-jwks-key.js for why this is plain JS,
    not a JavaCallout, and for the DER/ASN.1 construction itself
    (hand-verified against Node's own JWK-to-PEM conversion across
    multiple key sizes, plus an end-to-end real sign/verify round trip,
    before this was wired into the shared flow).

    Only RSA keys are supported (VerifyJWS is pinned to RS256 — see
    VerifyJWS-Jwt-Compact.xml). A kid match on a non-RSA kty throws
    (surfaces as a policy fault) rather than silently doing nothing.

    A kid with NO match in the JWKS sets
    signature.verify.jwt.jwks.key.found = "false" rather than throwing —
    that's an expected outcome (an unknown or rotated-out key), not a
    programming error, so RF-JWT-Verify-JWKS-Key-Not-Found raises a
    clean 401 for it, the same sets-a-flag/RaiseFault-checks-it pattern
    used throughout this bundle.
-->
<Javascript name="JS-JWT-Verify-Resolve-JWKS-Key" timeLimit="200">
    <DisplayName>JS-JWT-Verify-Resolve-JWKS-Key</DisplayName>
    <ResourceURL>jsc://jwt-verify-resolve-jwks-key.js</ResourceURL>
</Javascript>
