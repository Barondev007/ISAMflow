<?xml version="1.0" encoding="UTF-8"?>
<RaiseFault name="RF-JWT-Verify-JWKS-Key-Not-Found">
    <DisplayName>RF-JWT-Verify-JWKS-Key-Not-Found</DisplayName>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <FaultResponse>
        <Set>
            <StatusCode>401</StatusCode>
            <ReasonPhrase>Unauthorized</ReasonPhrase>
            <Payload contentType="application/json">{
    "error": "invalid_signature",
    "message": "No key matching kid '{signature.verify.jwt.header.kid}' was found in the JWKS document."
}</Payload>
        </Set>
    </FaultResponse>
</RaiseFault>
