<?xml version="1.0" encoding="UTF-8"?>
<!--
    Guard: this proxy's {apiproxy.name}.jwt.verify KVM entry has neither
    publicKeyPem nor jwksUri set — there's no key to verify against at
    all, so none of the four VerifyJWS-Jwt-* Conditions in
    sharedflows/default.xml would match. Catches this explicitly rather
    than letting the request fall through with no matching Step and no
    clear error.
-->
<RaiseFault name="RF-JWT-Verify-Key-Source-Missing">
    <DisplayName>RF-JWT-Verify-Key-Source-Missing</DisplayName>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <FaultResponse>
        <Set>
            <StatusCode>500</StatusCode>
            <ReasonPhrase>Internal Server Error</ReasonPhrase>
            <Payload contentType="application/json">{
    "error": "configuration_error",
    "message": "KVM entry '{signature.kvm.key}' has neither publicKeyPem nor jwksUri set — exactly one is required."
}</Payload>
        </Set>
    </FaultResponse>
</RaiseFault>
