<?xml version="1.0" encoding="UTF-8"?>
<!--
    Fetches the JWKS document from this proxy's KVM-configured jwksUri
    (see EV-JWT-Verify-Parse-Config). Only runs when publicKeyPem is
    empty (the JWKS-based path) AND
    LookupCache-JWT-Verify-JWKS-Key found nothing cached for this
    jwksUri+kid — see that policy's comment for the caching strategy;
    this step is the "miss" path, not the steady-state one.

    <HTTPTargetConnection><URL> is set from a flow variable via a
    message template ("{...}") — a fully dynamic ServiceCallout target
    URL is a standard, widely-documented Apigee capability (unlike KVM's
    mapIdentifier or VerifyJWS's KeyStore ref elsewhere in this project,
    both of which are static-only despite looking like they should
    support the same "{variable}" substitution — URL isn't an identifier
    Apigee needs to resolve at deploy time the way those are), but
    hasn't been exercised against a live instance in this project the
    way those two were, so confirm it resolves as expected when you
    deploy this.

    continueOnError lets the flow proceed past a network failure or a
    non-200 response so RF-JWT-Verify-JWKS-Fetch-Failed can raise a
    clear error instead of Apigee's generic ServiceCallout fault.

    This step itself is uncached — it only runs on a cache miss.
    PopulateCache-JWT-Verify-JWKS-Key caches the RESOLVED key after
    JS-JWT-Verify-Resolve-JWKS-Key runs, not the raw JWKS document, so a
    fetched-but-not-yet-cached response never sits around: the next
    request for the same kid hits the key cache directly and skips this
    ServiceCallout entirely.
-->
<ServiceCallout name="SC-JWT-Verify-Fetch-JWKS" continueOnError="true">
    <DisplayName>SC-JWT-Verify-Fetch-JWKS</DisplayName>
    <Request clearPayload="true">
        <Set>
            <Verb>GET</Verb>
        </Set>
    </Request>
    <Response>signature.verify.jwt.jwks.response</Response>
    <HTTPTargetConnection>
        <URL>{signature.verify.jwt.jwksUri}</URL>
    </HTTPTargetConnection>
    <Timeout>5000</Timeout>
</ServiceCallout>
