<?xml version="1.0" encoding="UTF-8"?>
<!--
    JWT/JWS verification, compact serialization, for a proxy whose KVM
    config has a jwksUri instead of a static publicKeyPem (see
    EV-JWT-Verify-Parse-Config). Runs when signature.verify.type = "jwt"
    AND signature.verify.jwt.detached != "true" AND
    signature.verify.jwt.jwksUri != "" — see VerifyJWS-Jwt-Compact for
    the publicKeyPem-configured sibling this mirrors otherwise
    (Algorithm/KnownHeaders/IgnoreCriticalHeaders reasoning identical),
    and VerifyJWS-Jwt-Detached-JWKS for the detached-JWS equivalent.

    <PublicKey><JWKS uri="..."/></PublicKey> is Apigee's native JWKS
    support: fetches the JWKS document from the given URI, matches the
    entry whose "kid" equals the JWS header's own "kid" automatically
    (that's the entire point of a key SET), and caches the fetched
    document — replacing what used to be a hand-rolled pipeline in this
    project (a JS step to read "kid" out of the JWS header, a
    ServiceCallout to fetch the JWKS document, and a JS step to find the
    matching entry and repackage its RSA modulus/exponent as PEM). This
    is simpler and more correct whenever it's actually available: one
    policy versus five, and Apigee's own kid-matching instead of ours.

    UNVERIFIED: I can't check this exact shape — specifically, whether
    the "uri" attribute resolves a "{variable}" reference the way it
    does here, as opposed to only accepting a literal URL — against
    Apigee's reference docs or a live instance from here. This is a
    standard, commonly-documented Apigee capability (unlike the KVM
    mapIdentifier and VerifyJWS KeyStore-ref cases elsewhere in this
    project, both of which looked like they should support "{variable}"
    by analogy and turned out not to), so my confidence is reasonably
    high, but confirm it against a live deploy before trusting it — if
    the uri attribute turns out not to template-resolve, or the "kid"
    auto-matching needs a different element/attribute, this is the only
    policy that needs to change; nothing else in the shared flow depends
    on its internals.
-->
<VerifyJWS name="VerifyJWS-Jwt-Compact-JWKS" continueOnError="false">
    <DisplayName>VerifyJWS-Jwt-Compact-JWKS</DisplayName>
    <Algorithm>RS256</Algorithm>
    <Source>signature.verify.jwt.jws</Source>
    <PublicKey>
        <JWKS uri="{signature.verify.jwt.jwksUri}"/>
    </PublicKey>
    <KnownHeaders ref="signature.verify.jwt.knownHeaders"/>
    <IgnoreCriticalHeaders>false</IgnoreCriticalHeaders>
    <VariablePrefix>signature.verify.jwt</VariablePrefix>
</VerifyJWS>
