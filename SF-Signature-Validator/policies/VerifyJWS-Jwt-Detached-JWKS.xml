<?xml version="1.0" encoding="UTF-8"?>
<!--
    Same as VerifyJWS-Jwt-Compact-JWKS, for detached JWS
    (header..signature — RFC 7515 Appendix F), for a proxy whose KVM
    config has a jwksUri instead of a static publicKeyPem. Runs when
    signature.verify.type = "jwt" AND signature.verify.jwt.detached =
    "true" AND signature.verify.jwt.jwksUri != "" — see
    VerifyJWS-Jwt-Compact-JWKS for the native-JWKS reasoning and the
    UNVERIFIED note on the <JWKS uri="..."/> shape, and
    VerifyJWS-Jwt-Detached for the publicKeyPem-configured, detached-JWS
    sibling this mirrors otherwise. The original payload, which a
    detached JWS doesn't carry, is staged by
    AM-JWT-Verify-Set-Detached-Payload from response.content — it's what
    DetachedContent hashes to recompute the digest the signature covers.
-->
<VerifyJWS name="VerifyJWS-Jwt-Detached-JWKS" continueOnError="false">
    <DisplayName>VerifyJWS-Jwt-Detached-JWKS</DisplayName>
    <Algorithm>RS256</Algorithm>
    <Source>signature.verify.jwt.jws</Source>
    <DetachedContent>signature.verify.jwt.payload</DetachedContent>
    <PublicKey>
        <JWKS uri="{signature.verify.jwt.jwksUri}"/>
    </PublicKey>
    <KnownHeaders ref="signature.verify.jwt.knownHeaders"/>
    <IgnoreCriticalHeaders>false</IgnoreCriticalHeaders>
    <VariablePrefix>signature.verify.jwt</VariablePrefix>
</VerifyJWS>
