<?xml version="1.0" encoding="UTF-8"?>
<!--
    Same as VerifyJWS-Jwt-Compact, for detached JWS (header..signature —
    RFC 7515 Appendix F). Runs when this proxy's KVM config says
    detached (signature.verify.jwt.detached = "true" — see
    EV-JWT-Verify-Parse-Config, not something the calling proxy sets).
    The original payload, which a detached JWS doesn't carry, is staged
    by AM-JWT-Verify-Set-Detached-Payload from response.content — it's
    what DetachedContent hashes to recompute the digest the signature
    covers.

    PublicKey is a PEM <Value ref="..."/>, not <KeyStore ref="..."/>, for
    the same reason as VerifyJWS-Jwt-Compact — see its comment for
    details, including how signature.verify.jwt.publicKey.pem can come
    from either a static publicKeyPem or a jwksUri KVM entry.
    EV-JWT-Verify-Parse-Config and (when jwksUri is in play)
    JS-JWT-Verify-Resolve-JWKS-Key both run before either VerifyJWS
    branch (see sharedflows/default.xml), so
    signature.verify.jwt.publicKey.pem is already populated by the time
    this step runs.
-->
<VerifyJWS name="VerifyJWS-Jwt-Detached" continueOnError="false">
    <DisplayName>VerifyJWS-Jwt-Detached</DisplayName>
    <Algorithm>RS256</Algorithm>
    <Source>signature.verify.jwt.jws</Source>
    <DetachedContent>signature.verify.jwt.payload</DetachedContent>
    <PublicKey>
        <Value ref="signature.verify.jwt.publicKey.pem"/>
    </PublicKey>
    <KnownHeaders ref="signature.verify.jwt.knownHeaders"/>
    <IgnoreCriticalHeaders>false</IgnoreCriticalHeaders>
    <VariablePrefix>signature.verify.jwt</VariablePrefix>
</VerifyJWS>
