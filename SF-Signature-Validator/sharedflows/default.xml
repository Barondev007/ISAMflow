<?xml version="1.0" encoding="UTF-8"?>
<SharedFlow name="default">

    <!-- ================================================================
         Guard: the calling API proxy must set signature.verify.type
         before invoking this shared flow (e.g. via AssignMessage, then
         FlowCallout with SharedFlowBundle="SF-Signature-Validator").
         ================================================================ -->
    <Step>
        <Name>RF-Missing-Signature-Verify-Type</Name>
        <Condition>signature.verify.type = null</Condition>
    </Step>

    <!-- ================================================================
         1) JWT / JWS verification — fully native for the check itself
         (VerifyJWS, no custom crypto). The calling proxy stages only the
         JWS itself into signature.verify.jwt.jws. Everything else —
         KnownHeaders, whether this proxy's scheme is compact or
         detached, and where the verification public key comes from — is
         per-proxy config from the shared KVM "signature" (entry key
         "{apiproxy.name}.jwt.verify"). When KVM says detached,
         AM-JWT-Verify-Set-Detached-Payload stages the response payload
         itself — the calling proxy doesn't set signature.verify.jwt.payload
         or signature.verify.jwt.detached at all. VerifyJWS itself rejects
         an invalid/expired/malformed JWS, and — via
         KnownHeaders/IgnoreCriticalHeaders — enforces RFC 7515 §4.1.11's
         "crit" rule (continueOnError=false raises a policy fault) —
         nothing else needs to check a "valid" flag.

         The public key itself comes from one of two KVM-configured
         sources (see EV-JWT-Verify-Parse-Config), exactly one non-empty
         per proxy:
           - publicKeyPem: a static PEM pasted into KVM once — no
             network call. VerifyJWS's own
             <PublicKey><KeyStore ref="..."/></PublicKey> doesn't resolve
             a dynamic ref at runtime (confirmed against a live Apigee
             instance), and there's no other way to reach KeyStore key
             material from inside a running proxy, so this is populated
             out-of-band whenever the certificate is issued/rotated.
           - jwksUri: fetched per request (JS-JWT-Verify-Extract-Kid
             reads "kid" from the JWS header, SC-JWT-Verify-Fetch-JWKS
             fetches the JWKS document, JS-JWT-Verify-Resolve-JWKS-Key
             matches by kid and repackages the RSA key as PEM) — into
             the SAME signature.verify.jwt.publicKey.pem variable, so
             VerifyJWS-Jwt-Compact/-Detached don't know or care which
             path populated it.
         ================================================================ -->
    <Step>
        <Name>RF-JWT-Verify-Source-Missing</Name>
        <Condition>signature.verify.type = "jwt" AND signature.verify.jwt.jws = null</Condition>
    </Step>
    <Step>
        <Name>AM-JWT-Verify-Set-KVM-Key</Name>
        <Condition>signature.verify.type = "jwt"</Condition>
    </Step>
    <Step>
        <Name>KVM-Get-JWT-Verify-Config</Name>
        <Condition>signature.verify.type = "jwt"</Condition>
    </Step>
    <Step>
        <Name>RF-JWT-Verify-Config-Missing</Name>
        <Condition>signature.verify.type = "jwt" AND signature.verify.jwt.config.json = null</Condition>
    </Step>
    <Step>
        <Name>EV-JWT-Verify-Parse-Config</Name>
        <Condition>signature.verify.type = "jwt"</Condition>
    </Step>
    <Step>
        <Name>RF-JWT-Verify-Key-Source-Missing</Name>
        <Condition>signature.verify.type = "jwt" AND signature.verify.jwt.publicKey.pem = "" AND signature.verify.jwt.jwksUri = ""</Condition>
    </Step>
    <Step>
        <Name>JS-JWT-Verify-Extract-Kid</Name>
        <Condition>signature.verify.type = "jwt" AND signature.verify.jwt.publicKey.pem = ""</Condition>
    </Step>
    <Step>
        <Name>SC-JWT-Verify-Fetch-JWKS</Name>
        <Condition>signature.verify.type = "jwt" AND signature.verify.jwt.publicKey.pem = ""</Condition>
    </Step>
    <Step>
        <Name>RF-JWT-Verify-JWKS-Fetch-Failed</Name>
        <Condition>signature.verify.type = "jwt" AND signature.verify.jwt.publicKey.pem = "" AND signature.verify.jwt.jwks.response.status.code != 200</Condition>
    </Step>
    <Step>
        <Name>JS-JWT-Verify-Resolve-JWKS-Key</Name>
        <Condition>signature.verify.type = "jwt" AND signature.verify.jwt.publicKey.pem = ""</Condition>
    </Step>
    <Step>
        <Name>RF-JWT-Verify-JWKS-Key-Not-Found</Name>
        <Condition>signature.verify.type = "jwt" AND signature.verify.jwt.publicKey.pem = "" AND signature.verify.jwt.jwks.key.found = "false"</Condition>
    </Step>
    <Step>
        <Name>AM-JWT-Verify-Set-Detached-Payload</Name>
        <Condition>signature.verify.type = "jwt" AND signature.verify.jwt.detached = "true"</Condition>
    </Step>
    <Step>
        <Name>VerifyJWS-Jwt-Compact</Name>
        <Condition>signature.verify.type = "jwt" AND signature.verify.jwt.detached != "true"</Condition>
    </Step>
    <Step>
        <Name>VerifyJWS-Jwt-Detached</Name>
        <Condition>signature.verify.type = "jwt" AND signature.verify.jwt.detached = "true"</Condition>
    </Step>

    <!-- ================================================================
         2) HTTP Signature (Cavage) verification.
         Rebuilds the signing string from the CURRENT request per the
         headers list in the incoming Signature header itself, and
         checks (expires) — real, achievable in JS. The actual
         signature-value crypto check is still a placeholder (see
         NI-Cavage-Verify-Signature): no native policy exists for this,
         and JS can't reach KeyStore key material for RSA/ECDSA math.
         ================================================================ -->
    <Step>
        <Name>JS-Verify-Cavage-Signing-String</Name>
        <Condition>signature.verify.type = "cavage"</Condition>
    </Step>
    <Step>
        <Name>NI-Cavage-Verify-Signature</Name>
        <Condition>signature.verify.type = "cavage"</Condition>
    </Step>

    <!-- ================================================================
         3) XML Signature (XML-DSig) verification — fully implemented,
         via one JavaCallout (JC-XmlDsig-Verify-Signature) doing
         canonicalization + digest + the SignatureValue cryptographic
         check together, using the JDK's built-in JSR 105 implementation
         (javax.xml.crypto.dsig — no extra library). The verification
         public key (PEM) and key algorithm are per-proxy, from the
         shared KVM "signature" (entry key
         "{apiproxy.name}.xmldsig.verify") — same PEM-in-KVM pattern as
         JWT verification, for the same reason (see
         EV-XmlDsig-Verify-Parse-Config). The callout sets
         signature.verify.xmldsig.valid rather than raising a fault
         itself; RF-XmlDsig-Verify-Failed does that, so a failed
         verification gets this bundle's normal 401 shape.
         ================================================================ -->
    <Step>
        <Name>AM-XmlDsig-Verify-Set-KVM-Key</Name>
        <Condition>signature.verify.type = "xmldsig"</Condition>
    </Step>
    <Step>
        <Name>KVM-Get-XmlDsig-Verify-Config</Name>
        <Condition>signature.verify.type = "xmldsig"</Condition>
    </Step>
    <Step>
        <Name>RF-XmlDsig-Verify-Config-Missing</Name>
        <Condition>signature.verify.type = "xmldsig" AND signature.verify.xmldsig.config.json = null</Condition>
    </Step>
    <Step>
        <Name>EV-XmlDsig-Verify-Parse-Config</Name>
        <Condition>signature.verify.type = "xmldsig"</Condition>
    </Step>
    <Step>
        <Name>JC-XmlDsig-Verify-Signature</Name>
        <Condition>signature.verify.type = "xmldsig"</Condition>
    </Step>
    <Step>
        <Name>RF-XmlDsig-Verify-Failed</Name>
        <Condition>signature.verify.type = "xmldsig" AND signature.verify.xmldsig.valid != "true"</Condition>
    </Step>

    <!-- ================================================================
         Guard: reject anything that isn't one of the three known types.
         ================================================================ -->
    <Step>
        <Name>RF-Unsupported-Signature-Verify-Type</Name>
        <Condition>signature.verify.type != "jwt" AND signature.verify.type != "cavage" AND signature.verify.type != "xmldsig"</Condition>
    </Step>

</SharedFlow>
