<?xml version="1.0" encoding="UTF-8"?>
<!-- Configures SF-Token-Retry for this proxy. Only tokenretry.url is required. -->
<AssignMessage name="AM-TokenRetry-Config">
    <DisplayName>AM-TokenRetry-Config</DisplayName>
    <AssignVariable>
        <Name>tokenretry.url</Name>
        <Template>https://{target.oauth2.host}{private.oauth2.basepath}</Template>
    </AssignVariable>
    <AssignVariable>
        <Name>tokenretry.mtls</Name>
        <Value>false</Value>
    </AssignVariable>
    <AssignVariable>
        <Name>tokenretry.maxAttempts</Name>
        <Value>3</Value>
    </AssignVariable>
    <AssignVariable>
        <Name>tokenretry.delaysMs</Name>
        <Value>500,1000</Value>
    </AssignVariable>
    <AssignVariable>
        <Name>tokenretry.budgetMs</Name>
        <Value>10000</Value>
    </AssignVariable>
    <IgnoreUnresolvedVariables>false</IgnoreUnresolvedVariables>
</AssignMessage>
