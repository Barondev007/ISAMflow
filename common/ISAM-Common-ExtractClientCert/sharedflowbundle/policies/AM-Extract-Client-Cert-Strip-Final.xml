<!--
  Reads client.cert.base64.step3, set by the previous policy STEP
  (AM-Extract-Client-Cert-Strip-Step3), and writes the final
  client.cert.base64, the canonical, armor-free, whitespace-free output
  this whole bundle exists to produce. See AM-Extract-Client-Cert-Strip-
  Step2's comment for why each transformation is its own policy.
-->
<AssignMessage name="AM-Extract-Client-Cert-Strip-Final">
    <DisplayName>AM Extract Client Cert Strip Final</DisplayName>
    <AssignVariable>
        <Name>client.cert.base64</Name>
        <Template>{replaceAll(client.cert.base64.step3,'\\s','')}</Template>
    </AssignVariable>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>
