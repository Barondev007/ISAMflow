<!--
  Authoritative source: the client certificate Apigee itself received during
  the two-way TLS handshake on its own VirtualHost, when mutual auth
  terminates at the gateway. tls.client.raw.cert is only populated when the
  VirtualHost has ClientAuthEnabled + a TrustStore configured (Edge Private/
  Public Cloud) or propagateTLSInformation.clientProperties = true (Apigee X
  / hybrid); that is environment/VirtualHost config outside this bundle, not
  something a SharedFlowBundle can set. Plain <Ref> copies, not
  <Value>/<Template>, since these are straight variable-to-variable copies.

  tls.client.s.dn / tls.client.i.dn (subject/issuer DN) come from the same
  handshake as tls.client.raw.cert and are subject to the same VirtualHost
  config; they are NOT derivable from the X-Client-Cert header fallback (that
  header only ever carries the raw cert in this project, never a pre-parsed
  DN), so client.cert.subject.dn/.issuer.dn stay null whenever the fallback
  path is the one that resolved client.cert.pem.
-->
<AssignMessage name="AM-Extract-Client-Cert-TLS">
    <DisplayName>AM Extract Client Cert TLS</DisplayName>
    <AssignVariable>
        <Name>client.cert.pem</Name>
        <Ref>tls.client.raw.cert</Ref>
    </AssignVariable>
    <AssignVariable>
        <Name>client.cert.subject.dn</Name>
        <Ref>tls.client.s.dn</Ref>
    </AssignVariable>
    <AssignVariable>
        <Name>client.cert.issuer.dn</Name>
        <Ref>tls.client.i.dn</Ref>
    </AssignVariable>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>
