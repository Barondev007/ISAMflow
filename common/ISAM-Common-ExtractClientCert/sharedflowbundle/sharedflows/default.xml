<SharedFlow name="default">
    <!-- Both gated on tls.client.raw.cert itself (not run unconditionally):
         a Template-based AssignVariable always produces a string, even ""
         when its source is unresolved, so running AM-Extract-Client-Cert-TLS
         unconditionally would end with the DN variables set to "" instead of
         staying null. JS-Extract-Client-Cert-Strip guards internally too
         (see its own .js source), but keeping the same Condition here is
         cheap and keeps both steps' gating consistent and easy to read
         together. -->
    <Step>
        <Condition>tls.client.raw.cert != null</Condition>
        <Name>AM-Extract-Client-Cert-TLS</Name>
    </Step>
    <Step>
        <Condition>tls.client.raw.cert != null</Condition>
        <Name>JS-Extract-Client-Cert-Strip</Name>
    </Step>
    <Step>
        <Condition>client.cert.base64 = null</Condition>
        <Name>AM-Extract-Client-Cert-Header-Fallback</Name>
    </Step>
</SharedFlow>
