<?xml version="1.0" encoding="UTF-8"?>
<ProxyEndpoint name="default">
    <PreFlow name="PreFlow">
        <Request>
            <Step>
                <Name>FC-Extract-SAML</Name>
            </Step>
            <Step>
                <Name>EV-Extract-SAML-Claims</Name>
            </Step>
            <Step>
                <Name>AM-Set-Signature-Type</Name>
            </Step>
            <Step>
                <Name>FC-Sign-JWT</Name>
            </Step>
        </Request>
        <Response/>
    </PreFlow>
    <Flows/>
    <HTTPProxyConnection>
        <BasePath>/orders</BasePath>
    </HTTPProxyConnection>
    <RouteRule name="default">
        <TargetEndpoint>default</TargetEndpoint>
    </RouteRule>
</ProxyEndpoint>
