<SharedFlowBundle revision="1" name="ISAM-JSON-TokenExchange">
    <ConfigurationVersion majorVersion="4" minorVersion="0"/>
    <CreatedAt>1735689600000</CreatedAt>
    <LastModifiedAt>1735689600000</LastModifiedAt>
    <Description>JSON-request/JSON-response sibling of ISAM-WSTrust-TokenExchange: same KVM-driven host failover, same static+dynamic attribute set, but sends a JSON token-exchange request instead of a WS-Trust SOAP envelope and parses the SAML assertion out of a JSON response field instead of an XML one.</Description>
    <Policies>
        <Policy>KVM-Get-ISAMJSONConfig</Policy>
        <Policy>RF-ISAM-Config-Missing</Policy>
        <Policy>EV-Extract-BearerToken</Policy>
        <Policy>RF-Missing-Bearer-Token</Policy>
        <Policy>AM-Set-Default-CompressSaml</Policy>
        <Policy>AM-Build-JSON-Request</Policy>
        <Policy>SC-Call-ISAM-JSON-Primary</Policy>
        <Policy>SC-Call-ISAM-JSON-Secondary</Policy>
        <Policy>RF-ISAM-Unavailable</Policy>
        <Policy>EV-Parse-JSON-Primary-Response</Policy>
        <Policy>EV-Parse-JSON-Secondary-Response</Policy>
        <Policy>RF-JSON-Fault</Policy>
        <Policy>JC-Validate-SAML-Signature</Policy>
        <Policy>RF-SAML-Signature-Invalid</Policy>
        <Policy>JC-Compress-SAML-Assertion</Policy>
        <Policy>AM-Set-SAML-Response-Header</Policy>
    </Policies>
    <SharedFlows>
        <SharedFlow>default</SharedFlow>
    </SharedFlows>
    <Resources>
        <Resource>java://isam-saml-callouts.jar</Resource>
    </Resources>
</SharedFlowBundle>
