<!--
  Builds the JSON token-exchange request natively (AssignMessage + Apigee's
  built-in message-template functions: escapeJSON, createUuid); same
  no-JS/no-Java approach as the WS-Trust bundle's AM-Build-WSTrust-Request.

  Static attributes (requestType/tokenType/keyType/appliesTo) come from KVM
  (isamjson.config.*, set by KVM-Get-ISAMJSONConfig). Dynamic attributes come
  off the inbound request, same set and same caveats as the WS-Trust bundle:
    - bearer token:        isamjson.bearer.token (EV-Extract-BearerToken)
    - client IP:            client.ip (Apigee-native)
    - X-Forwarded-For:      request.header.X-Forwarded-For, passed through
                             verbatim (not split into "first hop")
    - User-Agent:            request.header.User-Agent
    - client certificate:   request.header.X-Client-Cert; hard-coded header
                             name (see README "Client certificate header"),
                             expected pre-normalized to bare base64 by
                             whatever terminates mTLS in front of Apigee.

  Unlike the WS-Trust envelope, the bearer token is sent as plain text here,
  not base64; that encoding was a WS-Security BinarySecurityToken
  convention, not something a JSON API would typically expect. escapeJSON()
  is applied to every dynamic string regardless, since unlike XML, unescaped
  quotes/backslashes in a header value would break the JSON structure itself
  (a JWT never contains them, but User-Agent or a client cert blob could).
-->
<AssignMessage name="AM-Build-JSON-Request">
    <DisplayName>AM Build JSON Request</DisplayName>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <Set>
        <Payload contentType="application/json">
            {
              "requestId": "{createUuid()}",
              "requestType": "{escapeJSON(isamjson.config.requestType)}",
              "tokenType": "{escapeJSON(isamjson.config.tokenType)}",
              "keyType": "{escapeJSON(isamjson.config.keyType)}",
              "appliesTo": "{escapeJSON(isamjson.config.appliesTo)}",
              "bearerToken": "{escapeJSON(isamjson.bearer.token)}",
              "clientContext": {
                "ip": "{escapeJSON(client.ip)}",
                "forwardedFor": "{escapeJSON(request.header.X-Forwarded-For)}",
                "userAgent": "{escapeJSON(request.header.User-Agent)}",
                "clientCertificate": "{escapeJSON(request.header.X-Client-Cert)}"
              }
            }
        </Payload>
    </Set>
    <AssignTo createNew="true" transport="http" type="request">isamJsonRequestMsg</AssignTo>
</AssignMessage>
