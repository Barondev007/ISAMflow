<ServiceCallout name="SC-Call-ISAM-JSON-Secondary" continueOnError="true">
    <DisplayName>SC Call ISAM JSON Secondary</DisplayName>
    <Request clearPayload="true" variable="isamjson.callout.request.secondary">
        <Set>
            <Verb>POST</Verb>
            <Headers>
                <Header name="Accept">application/json</Header>
            </Headers>
            <Payload contentType="application/json">{isamJsonRequestMsg.content}</Payload>
        </Set>
    </Request>
    <Response>isamJsonSecondaryResponse</Response>
    <Timeout>10000</Timeout>
    <HTTPTargetConnection>
        <URL>{isamjson.config.scheme}://{isamjson.config.host2}:{isamjson.config.port}{isamjson.config.path}</URL>
        <SSLInfo>
            <Enabled>true</Enabled>
            <TrustStore>ref://isam-truststore-ref</TrustStore>
        </SSLInfo>
        <Properties>
            <Property name="connect.timeout.millis">{isamjson.config.connectTimeoutMs}</Property>
            <Property name="io.timeout.millis">{isamjson.config.ioTimeoutMs}</Property>
        </Properties>
    </HTTPTargetConnection>
</ServiceCallout>
