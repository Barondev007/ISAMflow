<SharedFlow name="default">
    <Step>
        <Name>KVM-Get-ISAMJSONConfig</Name>
    </Step>
    <Step>
        <Condition>isamjson.config.host1 = null OR isamjson.config.host2 = null OR isamjson.config.port = null OR isamjson.config.scheme = null OR isamjson.config.path = null OR isamjson.config.appliesTo = null OR isamjson.config.tokenType = null OR isamjson.config.keyType = null OR isamjson.config.requestType = null</Condition>
        <Name>RF-ISAM-Config-Missing</Name>
    </Step>

    <Step>
        <Name>EV-Extract-BearerToken</Name>
    </Step>
    <Step>
        <Condition>isamjson.bearer.token = null</Condition>
        <Name>RF-Missing-Bearer-Token</Name>
    </Step>

    <!-- compressSaml: a calling proxy may set this flow variable before invoking
         the FlowCallout to override the KVM default for this one request. -->
    <Step>
        <Condition>compressSaml = null</Condition>
        <Name>AM-Set-Default-CompressSaml</Name>
    </Step>

    <Step>
        <Name>AM-Build-JSON-Request</Name>
    </Step>

    <!-- Call the primary ISAM host. -->
    <Step>
        <Name>SC-Call-ISAM-JSON-Primary</Name>
    </Step>

    <!-- Per spec: only failover to the secondary host on a transport failure
         or an explicit HTTP 500 from the primary, not on other 4xx/5xx,
         since those would presumably fail identically on the secondary too. -->
    <Step>
        <Condition>SC-Call-ISAM-JSON-Primary.failed = true OR isamJsonPrimaryResponse.status.code = 500</Condition>
        <Name>SC-Call-ISAM-JSON-Secondary</Name>
    </Step>

    <!-- Both hosts genuinely unreachable / 500. -->
    <Step>
        <Condition>(SC-Call-ISAM-JSON-Primary.failed = true OR isamJsonPrimaryResponse.status.code = 500) AND (SC-Call-ISAM-JSON-Secondary.failed = true OR isamJsonSecondaryResponse.status.code = 500)</Condition>
        <Name>RF-ISAM-Unavailable</Name>
    </Step>

    <!-- Parse whichever call actually succeeded (HTTP 200). -->
    <Step>
        <Condition>SC-Call-ISAM-JSON-Primary.failed = false AND isamJsonPrimaryResponse.status.code = 200</Condition>
        <Name>EV-Parse-JSON-Primary-Response</Name>
    </Step>
    <Step>
        <Condition>(SC-Call-ISAM-JSON-Primary.failed = true OR isamJsonPrimaryResponse.status.code != 200) AND SC-Call-ISAM-JSON-Secondary.failed = false AND isamJsonSecondaryResponse.status.code = 200</Condition>
        <Name>EV-Parse-JSON-Secondary-Response</Name>
    </Step>

    <!-- No SAML assertion extracted from either response (an error field
         instead, unexpected shape, or both calls failed without tripping
         RF-ISAM-Unavailable above). -->
    <Step>
        <Condition>isamjson.response.assertion.xml = null OR isamjson.response.assertion.xml = ""</Condition>
        <Name>RF-JSON-Fault</Name>
    </Step>

    <!-- Validate the assertion's XML-DSig signature against its own embedded
         certificate (optionally pinned against isamjson.config.trustedThumbprints).
         Same Java callout as the WS-Trust bundle; see its README "Why Java
         is still here", since nothing about JSON vs XML transport changes that. -->
    <Step>
        <Name>JC-Validate-SAML-Signature</Name>
    </Step>
    <Step>
        <Condition>saml.signature.valid = false</Condition>
        <Name>RF-SAML-Signature-Invalid</Name>
    </Step>

    <!-- Zip + base64 the assertion when compressSaml is true; otherwise just
         base64 it. -->
    <Step>
        <Name>JC-Compress-SAML-Assertion</Name>
    </Step>

    <!-- Fall back to the Java-parsed subject/lifetime if the assumed JSON
         response fields (subjectId/notBefore/notOnOrAfter) aren't actually
         there; see the policy's own comment. -->
    <Step>
        <Name>AM-Coalesce-JSON-Metadata</Name>
    </Step>

    <Step>
        <Name>AM-Set-SAML-Response-Header</Name>
    </Step>
</SharedFlow>
