<SharedFlowBundle revision="1" name="ISAM-WSTrust-TokenExchange">
    <ConfigurationVersion majorVersion="4" minorVersion="0"/>
    <CreatedAt>1735689600000</CreatedAt>
    <LastModifiedAt>1735689600000</LastModifiedAt>
    <Description>Builds and sends a WS-Trust RequestSecurityToken to ISAM (with KVM-driven host failover on 500), extracts and validates the returned SAML assertion's signature, optionally zip-compresses it, and exposes it to the calling proxy. Built entirely from native Apigee policies except for two steps (XML-DSig signature verification, zip compression) that have no native Apigee equivalent.</Description>
    <Policies>
        <Policy>KVM-Get-ISAMConfig</Policy>
        <Policy>RF-ISAM-Config-Missing</Policy>
        <Policy>EV-Extract-BearerToken</Policy>
        <Policy>RF-Missing-Bearer-Token</Policy>
        <Policy>AM-Set-Default-CompressSaml</Policy>
        <Policy>AM-Build-WSTrust-Request</Policy>
        <Policy>SC-Call-ISAM-Primary</Policy>
        <Policy>SC-Call-ISAM-Secondary</Policy>
        <Policy>RF-ISAM-Unavailable</Policy>
        <Policy>EV-Parse-Primary-Response</Policy>
        <Policy>EV-Parse-Secondary-Response</Policy>
        <Policy>RF-WSTrust-Fault</Policy>
        <Policy>JC-Validate-SAML-Signature</Policy>
        <Policy>RF-SAML-Signature-Invalid</Policy>
        <Policy>JC-Compress-SAML-Assertion</Policy>
        <Policy>AM-Set-SAML-Response-Header</Policy>
    </Policies>
    <SharedFlows>
        <SharedFlow>default</SharedFlow>
    </SharedFlows>
    <Resources>
        <Resource>java://isam-saml-callouts.jar</Resource>
    </Resources>
</SharedFlowBundle>
