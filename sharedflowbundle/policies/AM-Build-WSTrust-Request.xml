<!--
  Builds the WS-Trust RequestSecurityToken SOAP envelope entirely with native
  Apigee message-template functions (escapeXML, createUuid, encodeBase64);
  no JavaScript/Java involved. The result lives in the wstrustRequestMsg
  message variable; SC-Call-ISAM-Primary/Secondary send {wstrustRequestMsg.content}
  as their POST body.

  Static attributes (RequestType/TokenType/KeyType/AppliesTo) come from KVM
  (isam.config.*, set by KVM-Get-ISAMConfig). Dynamic attributes come off the
  inbound request:
    - bearer token:        wstrust.bearer.token (EV-Extract-BearerToken)
    - client IP:            client.ip (Apigee-native)
    - X-Forwarded-For:      request.header.X-Forwarded-For, passed through verbatim
                             (no "first hop" parsing; let ISAM's mapping decide)
    - User-Agent:            request.header.User-Agent
    - client certificate:   request.header.X-Client-Cert; hard-coded header
                             name (see README "Client certificate header"): a
                             dynamic/KVM-configurable header name would need
                             indirect variable lookup, which native policies
                             can't do, only JavaScript can. The value is
                             expected pre-normalized to bare base64 (no PEM
                             armor, no URL-encoding) by whatever terminates
                             mTLS in front of Apigee, for the same reason.

  Any of the four optional context items (ip/forwardedFor/userAgent/
  clientCertificate) that aren't present on the request are simply empty
  strings here (IgnoreUnresolvedVariables) rather than omitted elements;
  a deliberate simplification versus conditionally omitting them, which
  would need branching logic outside what a single Payload template can do.
-->
<AssignMessage name="AM-Build-WSTrust-Request">
    <DisplayName>AM Build WSTrust Request</DisplayName>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <Set>
        <Payload contentType="application/soap+xml; charset=utf-8">
            <soapenv:Envelope xmlns:soapenv="http://www.w3.org/2003/05/soap-envelope"
                               xmlns:wsse="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd"
                               xmlns:wsu="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd"
                               xmlns:wst="http://docs.oasis-open.org/ws-sx/ws-trust/200512"
                               xmlns:wsp="http://schemas.xmlsoap.org/ws/2004/09/policy"
                               xmlns:wsc="http://schemas.xmlsoap.org/ws/2006/12/authorization"
                               xmlns:wsa="http://www.w3.org/2005/08/addressing">
                <soapenv:Header>
                    <wsa:Action>http://docs.oasis-open.org/ws-sx/ws-trust/200512/RST/Issue</wsa:Action>
                    <wsa:MessageID>urn:uuid:{createUuid()}</wsa:MessageID>
                    <wsse:Security soapenv:mustUnderstand="1">
                        <wsse:BinarySecurityToken wsu:Id="bearerToken"
                            ValueType="urn:ietf:params:oauth:token-type:jwt"
                            EncodingType="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-soap-message-security-1.0#Base64Binary">{encodeBase64(wstrust.bearer.token)}</wsse:BinarySecurityToken>
                    </wsse:Security>
                </soapenv:Header>
                <soapenv:Body>
                    <wst:RequestSecurityToken>
                        <wst:RequestType>{escapeXML(isam.config.requestType)}</wst:RequestType>
                        <wst:TokenType>{escapeXML(isam.config.tokenType)}</wst:TokenType>
                        <wst:KeyType>{escapeXML(isam.config.keyType)}</wst:KeyType>
                        <wsp:AppliesTo>
                            <wsa:EndpointReference>
                                <wsa:Address>{escapeXML(isam.config.appliesTo)}</wsa:Address>
                            </wsa:EndpointReference>
                        </wsp:AppliesTo>
                        <wst:OnBehalfOf>
                            <wsse:BinarySecurityToken
                                ValueType="urn:ietf:params:oauth:token-type:jwt"
                                EncodingType="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-soap-message-security-1.0#Base64Binary">{encodeBase64(wstrust.bearer.token)}</wsse:BinarySecurityToken>
                        </wst:OnBehalfOf>
                        <wst:AdditionalContext xmlns="http://schemas.xmlsoap.org/ws/2006/12/authorization">
                            <wsc:ContextItem Name="ip"><wsc:Value>{escapeXML(client.ip)}</wsc:Value></wsc:ContextItem>
                            <wsc:ContextItem Name="forwardedFor"><wsc:Value>{escapeXML(request.header.X-Forwarded-For)}</wsc:Value></wsc:ContextItem>
                            <wsc:ContextItem Name="userAgent"><wsc:Value>{escapeXML(request.header.User-Agent)}</wsc:Value></wsc:ContextItem>
                            <wsc:ContextItem Name="clientCertificate"><wsc:Value>{escapeXML(request.header.X-Client-Cert)}</wsc:Value></wsc:ContextItem>
                        </wst:AdditionalContext>
                    </wst:RequestSecurityToken>
                </soapenv:Body>
            </soapenv:Envelope>
        </Payload>
    </Set>
    <AssignTo createNew="true" transport="http" type="request">wstrustRequestMsg</AssignTo>
</AssignMessage>
