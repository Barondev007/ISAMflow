<!--
  Picks whichever candidate EV-Parse-*-Response actually populated:
  isam.rstr.assertion.nodeset (real nested <saml:Assertion> element) if
  present, else isam.rstr.assertion.text (RequestedSecurityToken's string
  value, which is the assertion XML text when ISAM embedded it as escaped
  text instead of a real child element). Ref is tried first and only falls
  through to Value if it's unresolved, which is exactly "the XPath found
  no matching element" for the nodeset case.
-->
<AssignMessage name="AM-Coalesce-SAML-Assertion">
    <DisplayName>AM Coalesce SAML Assertion</DisplayName>
    <AssignVariable>
        <Name>isam.rstr.assertion.xml</Name>
        <Ref>isam.rstr.assertion.nodeset</Ref>
        <Value>{isam.rstr.assertion.text}</Value>
    </AssignVariable>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>
