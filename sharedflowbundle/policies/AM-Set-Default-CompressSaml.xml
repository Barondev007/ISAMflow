<!--
  Only runs (see the Step Condition in sharedflows/default.xml) when the
  calling proxy did not already set compressSaml itself, i.e. this is the
  KVM-driven default. Value="false" is the last-resort fallback if even the
  KVM entry is unset.
-->
<AssignMessage name="AM-Set-Default-CompressSaml">
    <DisplayName>AM Set Default CompressSaml</DisplayName>
    <AssignVariable>
        <Name>compressSaml</Name>
        <Ref>isam.config.compressSaml</Ref>
        <Value>false</Value>
    </AssignVariable>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>
