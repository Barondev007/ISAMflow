<AssignMessage name="AM-Set-SAML-Response-Header">
    <DisplayName>AM Set SAML Response Header</DisplayName>
    <Set>
        <Headers>
            <!-- Base64 payload: a real zip archive (single "assertion.xml" entry) when
                 compressSaml resolved true, otherwise a plain base64 of the assertion XML. -->
            <Header name="X-SAML-Assertion">{saml.assertion.output}</Header>
            <Header name="X-SAML-Assertion-Compressed">{saml.assertion.compressed}</Header>
            <Header name="X-SAML-Subject-Id">{isam.rstr.subject.id}</Header>
        </Headers>
    </Set>
    <AssignVariable>
        <Name>isam.exchanged.subject.id</Name>
        <Ref>isam.rstr.subject.id</Ref>
        <Value></Value>
    </AssignVariable>
    <AssignVariable>
        <Name>isam.exchanged.assertion.notBefore</Name>
        <Ref>isam.rstr.notBefore</Ref>
        <Value></Value>
    </AssignVariable>
    <AssignVariable>
        <Name>isam.exchanged.assertion.notOnOrAfter</Name>
        <Ref>isam.rstr.notOnOrAfter</Ref>
        <Value></Value>
    </AssignVariable>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="request"/>
</AssignMessage>
