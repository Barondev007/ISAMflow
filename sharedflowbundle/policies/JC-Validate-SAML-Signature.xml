<JavaCallout name="JC-Validate-SAML-Signature">
    <DisplayName>JC Validate SAML Signature</DisplayName>
    <Properties>
        <!-- Input: the raw <saml:Assertion> XML fragment extracted by EV-Parse-*-Response. -->
        <Property name="assertionVariable">isam.rstr.assertion.xml</Property>
        <!-- Optional signing-cert pinning: comma-separated SHA-256 thumbprints (hex,
             colons optional, case-insensitive). Empty = signature-only validation,
             no pinning. See README "Signature validation & trust". -->
        <Property name="trustedThumbprintsVariable">isam.config.trustedThumbprints</Property>
    </Properties>
    <ClassName>com.example.isam.callout.SamlSignatureValidator</ClassName>
    <ResourceURL>java://isam-saml-callouts.jar</ResourceURL>
</JavaCallout>
