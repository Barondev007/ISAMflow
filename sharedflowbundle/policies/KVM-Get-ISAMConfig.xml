<KeyValueMapOperations name="KVM-Get-ISAMConfig" mapIdentifier="ISAM.WSTrust.Config">
    <DisplayName>KVM Get ISAM Config</DisplayName>
    <Scope>environment</Scope>
    <ExpiryTimeInSecs>300</ExpiryTimeInSecs>
    <!-- One KVM key per config field (rather than one JSON blob) so nothing
         downstream needs to parse JSON; see scripts/provision-kvm.sh. -->
    <Get assignTo="isam.config.host1"><Key><Parameter>isam.sts.host1</Parameter></Key></Get>
    <Get assignTo="isam.config.host2"><Key><Parameter>isam.sts.host2</Parameter></Key></Get>
    <Get assignTo="isam.config.port"><Key><Parameter>isam.sts.port</Parameter></Key></Get>
    <Get assignTo="isam.config.scheme"><Key><Parameter>isam.sts.scheme</Parameter></Key></Get>
    <Get assignTo="isam.config.path"><Key><Parameter>isam.sts.path</Parameter></Key></Get>
    <Get assignTo="isam.config.connectTimeoutMs"><Key><Parameter>isam.sts.connectTimeoutMs</Parameter></Key></Get>
    <Get assignTo="isam.config.ioTimeoutMs"><Key><Parameter>isam.sts.ioTimeoutMs</Parameter></Key></Get>
    <Get assignTo="isam.config.appliesTo"><Key><Parameter>isam.sts.appliesTo</Parameter></Key></Get>
    <Get assignTo="isam.config.tokenType"><Key><Parameter>isam.sts.tokenType</Parameter></Key></Get>
    <Get assignTo="isam.config.keyType"><Key><Parameter>isam.sts.keyType</Parameter></Key></Get>
    <Get assignTo="isam.config.requestType"><Key><Parameter>isam.sts.requestType</Parameter></Key></Get>
    <Get assignTo="isam.config.compressSaml"><Key><Parameter>isam.sts.compressSaml</Parameter></Key></Get>
    <Get assignTo="isam.config.trustedThumbprints"><Key><Parameter>isam.sts.trustedSigningCertThumbprints</Parameter></Key></Get>
</KeyValueMapOperations>
