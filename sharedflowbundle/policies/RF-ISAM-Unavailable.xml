<RaiseFault name="RF-ISAM-Unavailable">
    <DisplayName>RF ISAM Unavailable</DisplayName>
    <FaultResponse>
        <Set>
            <Payload contentType="application/json">
                {
                  "error": "isam_unavailable",
                  "message": "Both configured ISAM WS-Trust hosts failed to respond.",
                  "primaryHost": "{isam.config.host1}",
                  "secondaryHost": "{isam.config.host2}"
                }
            </Payload>
            <StatusCode>502</StatusCode>
            <ReasonPhrase>Bad Gateway</ReasonPhrase>
        </Set>
    </FaultResponse>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
