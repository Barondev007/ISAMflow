<RaiseFault name="RF-WSTrust-Fault">
    <DisplayName>RF WSTrust Fault</DisplayName>
    <FaultResponse>
        <Set>
            <Payload contentType="application/json">
                {
                  "error": "wstrust_exchange_failed",
                  "message": "ISAM returned a SOAP Fault or no RequestedSecurityToken was present in the response.",
                  "isamFaultReason": "{isam.rstr.fault}"
                }
            </Payload>
            <StatusCode>502</StatusCode>
            <ReasonPhrase>Bad Gateway</ReasonPhrase>
        </Set>
    </FaultResponse>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
