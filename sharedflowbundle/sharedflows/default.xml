<SharedFlow name="default">
    <Step>
        <Name>KVM-Get-ISAMConfig</Name>
    </Step>
    <Step>
        <Condition>isam.config.host1 = null OR isam.config.host2 = null OR isam.config.port = null OR isam.config.scheme = null OR isam.config.path = null OR isam.config.appliesTo = null OR isam.config.tokenType = null OR isam.config.keyType = null OR isam.config.requestType = null</Condition>
        <Name>RF-ISAM-Config-Missing</Name>
    </Step>

    <Step>
        <Name>EV-Extract-BearerToken</Name>
    </Step>
    <Step>
        <Condition>wstrust.bearer.token = null</Condition>
        <Name>RF-Missing-Bearer-Token</Name>
    </Step>

    <!-- compressSaml: a calling proxy may set this flow variable before invoking
         the FlowCallout to override the KVM default for this one request. -->
    <Step>
        <Condition>compressSaml = null</Condition>
        <Name>AM-Set-Default-CompressSaml</Name>
    </Step>

    <Step>
        <Name>AM-Build-WSTrust-Request</Name>
    </Step>

    <!-- Call the primary ISAM host. -->
    <Step>
        <Name>SC-Call-ISAM-Primary</Name>
    </Step>

    <!-- Per spec: only failover to the secondary host on a transport failure
         or an explicit HTTP 500 from the primary, not on other 4xx/5xx,
         since those would presumably fail identically on the secondary too. -->
    <Step>
        <Condition>SC-Call-ISAM-Primary.failed = true OR isamPrimaryResponse.status.code = 500</Condition>
        <Name>SC-Call-ISAM-Secondary</Name>
    </Step>

    <!-- Both hosts genuinely unreachable / 500. -->
    <Step>
        <Condition>(SC-Call-ISAM-Primary.failed = true OR isamPrimaryResponse.status.code = 500) AND (SC-Call-ISAM-Secondary.failed = true OR isamSecondaryResponse.status.code = 500)</Condition>
        <Name>RF-ISAM-Unavailable</Name>
    </Step>

    <!-- Parse whichever call actually succeeded (HTTP 200). -->
    <Step>
        <Condition>SC-Call-ISAM-Primary.failed = false AND isamPrimaryResponse.status.code = 200</Condition>
        <Name>EV-Parse-Primary-Response</Name>
    </Step>
    <Step>
        <Condition>(SC-Call-ISAM-Primary.failed = true OR isamPrimaryResponse.status.code != 200) AND SC-Call-ISAM-Secondary.failed = false AND isamSecondaryResponse.status.code = 200</Condition>
        <Name>EV-Parse-Secondary-Response</Name>
    </Step>

    <!-- Pick whichever of the two candidate extractions actually matched;
         see EV-Parse-Primary-Response's comment for why there are two. -->
    <Step>
        <Name>AM-Coalesce-SAML-Assertion</Name>
    </Step>

    <!-- No SAML assertion extracted from either response (SOAP fault, unexpected
         shape, or both calls failed without tripping RF-ISAM-Unavailable above). -->
    <Step>
        <Condition>isam.rstr.assertion.xml = null OR isam.rstr.assertion.xml = ""</Condition>
        <Name>RF-WSTrust-Fault</Name>
    </Step>

    <!-- Validate the assertion's XML-DSig signature against its own embedded
         certificate (optionally pinned against isam.config.trustedThumbprints).
         No native Apigee policy exists for XML-DSig verification, so this one
         step stays a Java callout; see README "Why Java is still here". -->
    <Step>
        <Name>JC-Validate-SAML-Signature</Name>
    </Step>
    <Step>
        <Condition>saml.signature.valid = false</Condition>
        <Name>RF-SAML-Signature-Invalid</Name>
    </Step>

    <!-- Zip + base64 the assertion when compressSaml is true; otherwise just
         base64 it. No native Apigee policy exists for zip compression either,
         so this is the other Java callout; see README "Why Java is still here". -->
    <Step>
        <Name>JC-Compress-SAML-Assertion</Name>
    </Step>

    <Step>
        <Name>AM-Set-SAML-Response-Header</Name>
    </Step>
</SharedFlow>
