<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
    Extract of a ProxyEndpoint: the ISAM token exchange (../../isam-token-exchange) runs in the PreFlow, the TPRF check runs
    in each OAS conditional flow so that current.flow.name is the operation name.
-->
<ProxyEndpoint name="default">
    <PreFlow name="PreFlow">
        <Request>
            <!-- certificate extraction (requestctxcert, requestCtxCertFullDn), then the ISAM token exchange -->
            <Step>
                <!-- or FC-ISAM-Token-Exchange-Stsuu for an end-user call -->
                <Name>FC-ISAM-Token-Exchange-AccessToken</Name>
            </Step>
        </Request>
    </PreFlow>
    <Flows>
        <Flow name="validateCashAccount">
            <Condition>(proxy.pathsuffix MatchesPath "/cash-accounts/validate") and (request.verb = "POST")</Condition>
            <Request>
                <Step>
                    <Name>KVM-TPRF-Method-Scopes</Name>
                </Step>
                <Step>
                    <Name>FC-TPRF-Validation</Name>
                </Step>
            </Request>
        </Flow>
    </Flows>
</ProxyEndpoint>
