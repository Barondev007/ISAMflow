<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
    Calls the tprf-validation shared flow.
    clientId and permissions are set by the isam-token-exchange shared flow.
    requestctxcert is the client certificate extracted by the proxy (PEM or base64 DER).
-->
<FlowCallout name="FC-TPRF-Validation">
    <DisplayName>FC-TPRF-Validation</DisplayName>
    <SharedFlowBundle>tprf-validation</SharedFlowBundle>
    <Parameters>
        <Parameter name="tprf.input.certificate" ref="requestctxcert"/>
        <Parameter name="tprf.input.clientId" ref="isam.saml.clientId"/>
        <Parameter name="tprf.input.permissions" ref="isam.saml.permissions"/>
        <Parameter name="tprf.input.methodScopes" ref="tprf.method.scopes"/>
    </Parameters>
</FlowCallout>
