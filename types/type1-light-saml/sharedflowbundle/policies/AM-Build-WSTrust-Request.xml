<!--
  Type 1 (light SAML): no bearer token at all; only the client certificate
  (plus IP/UA as contextual metadata, same as the other WS-Trust types).
  No wsse:Security header, no wst:OnBehalfOf, since there's no token to embed
  in either.
-->
<AssignMessage name="AM-Build-WSTrust-Request">
    <DisplayName>AM Build WSTrust Request</DisplayName>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <Set>
        <Payload contentType="application/soap+xml; charset=utf-8">
            <soapenv:Envelope xmlns:soapenv="http://www.w3.org/2003/05/soap-envelope"
                               xmlns:wst="http://docs.oasis-open.org/ws-sx/ws-trust/200512"
                               xmlns:wsp="http://schemas.xmlsoap.org/ws/2004/09/policy"
                               xmlns:wsc="http://schemas.xmlsoap.org/ws/2006/12/authorization"
                               xmlns:wsa="http://www.w3.org/2005/08/addressing">
                <soapenv:Header>
                    <wsa:Action>http://docs.oasis-open.org/ws-sx/ws-trust/200512/RST/Issue</wsa:Action>
                    <wsa:MessageID>urn:uuid:{createUuid()}</wsa:MessageID>
                </soapenv:Header>
                <soapenv:Body>
                    <wst:RequestSecurityToken>
                        <wst:RequestType>{escapeXML(isam.config.requestType)}</wst:RequestType>
                        <wst:TokenType>{escapeXML(isam.config.tokenType)}</wst:TokenType>
                        <wst:KeyType>{escapeXML(isam.config.keyType)}</wst:KeyType>
                        <wsp:AppliesTo>
                            <wsa:EndpointReference>
                                <wsa:Address>{escapeXML(isam.config.appliesTo)}</wsa:Address>
                            </wsa:EndpointReference>
                        </wsp:AppliesTo>
                        <wst:AdditionalContext xmlns="http://schemas.xmlsoap.org/ws/2006/12/authorization">
                            <wsc:ContextItem Name="ip"><wsc:Value>{escapeXML(client.ip)}</wsc:Value></wsc:ContextItem>
                            <wsc:ContextItem Name="forwardedFor"><wsc:Value>{escapeXML(request.header.X-Forwarded-For)}</wsc:Value></wsc:ContextItem>
                            <wsc:ContextItem Name="userAgent"><wsc:Value>{escapeXML(request.header.User-Agent)}</wsc:Value></wsc:ContextItem>
                            <wsc:ContextItem Name="clientCertificate"><wsc:Value>{escapeXML(request.header.X-Client-Cert)}</wsc:Value></wsc:ContextItem>
                        </wst:AdditionalContext>
                    </wst:RequestSecurityToken>
                </soapenv:Body>
            </soapenv:Envelope>
        </Payload>
    </Set>
    <AssignTo createNew="true" transport="http" type="request">wstrustRequestMsg</AssignTo>
</AssignMessage>
