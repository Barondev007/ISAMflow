<SharedFlowBundle revision="1" name="ISAM-SAML-User">
    <ConfigurationVersion majorVersion="4" minorVersion="0"/>
    <CreatedAt>1735689600000</CreatedAt>
    <LastModifiedAt>1735689600000</LastModifiedAt>
    <Description>
        Type 2: "user" SAML. Full WS-Trust RequestSecurityToken with the
        inbound bearer token embedded as OnBehalfOf, plus client IP/UA/cert
        as AdditionalContext. Calls the shared ISAM-Common-* building blocks
        for the actual ISAM callout, signature validation, compression, and
        header-setting; see the top-level README for the full architecture.
    </Description>
    <Policies>
        <Policy>KVM-Get-ISAMConfig</Policy>
        <Policy>RF-ISAM-Config-Missing</Policy>
        <Policy>EV-Extract-BearerToken</Policy>
        <Policy>RF-Missing-Bearer-Token</Policy>
        <Policy>AM-Set-Default-CompressSaml</Policy>
        <Policy>AM-Build-WSTrust-Request</Policy>
        <Policy>AM-Set-ISAMCall-Inputs</Policy>
        <Policy>FC-Call-ISAM</Policy>
        <Policy>EV-Parse-ISAM-Response</Policy>
        <Policy>AM-Coalesce-SAML-Assertion</Policy>
        <Policy>AM-Coalesce-SAML-Assertion-Fallback</Policy>
        <Policy>RF-WSTrust-Fault</Policy>
        <Policy>FC-Validate-Signature</Policy>
        <Policy>FC-Compress-Assertion</Policy>
        <Policy>FC-Set-SAML-Headers</Policy>
    </Policies>
    <SharedFlows>
        <SharedFlow>default</SharedFlow>
    </SharedFlows>
</SharedFlowBundle>
