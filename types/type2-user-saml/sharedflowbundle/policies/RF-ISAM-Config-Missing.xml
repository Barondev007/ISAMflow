<RaiseFault name="RF-ISAM-Config-Missing">
    <DisplayName>RF ISAM Config Missing</DisplayName>
    <FaultResponse>
        <Set>
            <Payload contentType="application/json">
                {
                  "error": "isam_config_missing",
                  "message": "One or more required entries are missing from the ISAM.SamlUser.Config KVM."
                }
            </Payload>
            <StatusCode>500</StatusCode>
            <ReasonPhrase>Internal Server Error</ReasonPhrase>
        </Set>
    </FaultResponse>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
