<!--
  Picks the nodeset candidate (a real nested saml:Assertion element) if
  EV-Parse-ISAM-Response found one, into the canonical saml.assertion.xml
  (the contract variable name every common building block reads).
  AM-Coalesce-SAML-Assertion-Fallback (Condition-gated in sharedflows/
  default.xml on saml.assertion.xml still being null after this step)
  covers the escaped-text case. Also copies this type's own
  trustedThumbprints config into the canonical saml.trustedThumbprints name.
-->
<AssignMessage name="AM-Coalesce-SAML-Assertion">
    <DisplayName>AM Coalesce SAML Assertion</DisplayName>
    <AssignVariable>
        <Name>saml.assertion.xml</Name>
        <Ref>isam.rstr.assertion.nodeset</Ref>
    </AssignVariable>
    <AssignVariable>
        <Name>saml.trustedThumbprints</Name>
        <Ref>isam.config.trustedThumbprints</Ref>
        <Value></Value>
    </AssignVariable>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>
