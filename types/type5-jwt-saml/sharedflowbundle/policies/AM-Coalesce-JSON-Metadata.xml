<!--
  Defensive fallback for the same class of bug the WS-Trust types actually
  hit: isamjson.response.subjectId/notBefore/notOnOrAfter are extracted via
  JSONPath against ASSUMED top-level response fields that were never
  confirmed against a real ISAM JSON contract. Runs AFTER FC-Validate-Signature
  (which already set saml.subject.id/notBefore/notOnOrAfter from the
  assertion XML directly, a source that doesn't depend on that assumption
  at all), and is itself Condition-gated in sharedflows/default.xml on
  isamjson.response.subjectId being non-null: this step only runs
  at all when the assumed JSON fields actually came back, so it's safe to
  use plain <Ref> copies here without worrying about what an unresolved
  Ref with no Value fallback would do to a variable that already has a
  value (that behavior isn't clearly documented either way, so this avoids
  depending on it, rather than assuming).
-->
<AssignMessage name="AM-Coalesce-JSON-Metadata">
    <DisplayName>AM Coalesce JSON Metadata</DisplayName>
    <AssignVariable>
        <Name>saml.subject.id</Name>
        <Ref>isamjson.response.subjectId</Ref>
    </AssignVariable>
    <AssignVariable>
        <Name>saml.assertion.notBefore</Name>
        <Ref>isamjson.response.notBefore</Ref>
    </AssignVariable>
    <AssignVariable>
        <Name>saml.assertion.notOnOrAfter</Name>
        <Ref>isamjson.response.notOnOrAfter</Ref>
    </AssignVariable>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>
