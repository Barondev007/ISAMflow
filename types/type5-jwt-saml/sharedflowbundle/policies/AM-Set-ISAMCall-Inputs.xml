<!--
  Bridges this type's own config/request into the ISAM-Common-CallISAM
  contract (see that bundle's own description for the full input/output
  list). AssignVariable's <Value> is ALWAYS a literal string, never
  message-template-substituted, regardless of whether it contains {..} or
  not; only <Template> does {..} substitution, and <Ref> does a plain
  variable-to-variable copy. A single-variable copy (the request body) uses
  Ref; a multi-token concatenation (the target URLs) uses Template; a real
  literal (the content type, the timeout defaults) uses Value.
-->
<AssignMessage name="AM-Set-ISAMCall-Inputs">
    <DisplayName>AM Set ISAMCall Inputs</DisplayName>
    <AssignVariable>
        <Name>isamcall.request.body</Name>
        <Ref>isamJsonRequestMsg.content</Ref>
    </AssignVariable>
    <AssignVariable>
        <Name>isamcall.request.contentType</Name>
        <Value>application/json</Value>
    </AssignVariable>
    <AssignVariable>
        <Name>isamcall.target.url.primary</Name>
        <Template>{isam.config.scheme}://{isam.config.host1}:{isam.config.port}{isam.config.path}</Template>
    </AssignVariable>
    <AssignVariable>
        <Name>isamcall.target.url.secondary</Name>
        <Template>{isam.config.scheme}://{isam.config.host2}:{isam.config.port}{isam.config.path}</Template>
    </AssignVariable>
    <AssignVariable>
        <Name>isamcall.connectTimeoutMs</Name>
        <Ref>isam.config.connectTimeoutMs</Ref>
        <Value>5000</Value>
    </AssignVariable>
    <AssignVariable>
        <Name>isamcall.ioTimeoutMs</Name>
        <Ref>isam.config.ioTimeoutMs</Ref>
        <Value>10000</Value>
    </AssignVariable>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>
