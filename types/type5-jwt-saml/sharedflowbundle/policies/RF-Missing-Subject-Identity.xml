<!--
  Replaces RF-Missing-Bearer-Token: a bearer token is no longer the only
  way to identify the caller for this type. Exactly one of the two request
  variants applies (see JS-Build-TokenExchange-Request), so this only fires
  when NEITHER identity is present.
-->
<RaiseFault name="RF-Missing-Subject-Identity">
    <DisplayName>RF Missing Subject Identity</DisplayName>
    <FaultResponse>
        <Set>
            <Payload contentType="application/json">
                {
                  "error": "missing_subject_identity",
                  "message": "Either an Authorization Bearer token or an X-User-Id header must be present."
                }
            </Payload>
            <StatusCode>401</StatusCode>
            <ReasonPhrase>Unauthorized</ReasonPhrase>
        </Set>
    </FaultResponse>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
