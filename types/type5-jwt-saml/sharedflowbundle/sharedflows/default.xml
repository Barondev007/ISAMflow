<SharedFlow name="default">
    <Step>
        <Name>KVM-Get-ISAMConfig</Name>
    </Step>
    <Step>
        <Condition>isam.config.host1 = null OR isam.config.host2 = null OR isam.config.port = null OR isam.config.scheme = null OR isam.config.path = null OR isam.config.subjectTokenTypeUserId = null OR isam.config.subjectTokenTypeAccessToken = null OR isam.config.requestedTokenType = null OR isam.config.audience = null</Condition>
        <Name>RF-ISAM-Config-Missing</Name>
    </Step>

    <Step>
        <Name>FC-Extract-Client-Cert</Name>
    </Step>

    <!-- Bearer token is optional here, unlike the WS-Trust types: this type
         accepts EITHER a bearer token (+ client certificate) OR an
         X-User-Id header, and builds a different subject_token shape for
         each; see JS-Build-TokenExchange-Request. -->
    <Step>
        <Name>EV-Extract-BearerToken</Name>
    </Step>
    <Step>
        <Condition>bearer.token = null AND request.header.X-User-Id = null</Condition>
        <Name>RF-Missing-Subject-Identity</Name>
    </Step>

    <Step>
        <Condition>compressSaml = null</Condition>
        <Name>AM-Set-Default-CompressSaml</Name>
    </Step>

    <Step>
        <Name>JS-Build-TokenExchange-Request</Name>
    </Step>
    <Step>
        <Name>AM-Set-ISAMCall-Inputs</Name>
    </Step>

    <Step>
        <Name>FC-Call-ISAM</Name>
    </Step>

    <Step>
        <Name>EV-Parse-ISAM-Response</Name>
    </Step>
    <Step>
        <Name>AM-Coalesce-SAML-Assertion</Name>
    </Step>

    <Step>
        <Condition>saml.assertion.xml = null OR saml.assertion.xml = ""</Condition>
        <Name>RF-JSON-Fault</Name>
    </Step>

    <Step>
        <Name>FC-Validate-Signature</Name>
    </Step>

    <!-- Prefer the assumed JSON response fields for subject/lifetime; only
         runs when they're actually present, so it never has to overwrite
         what FC-Validate-Signature already parsed out of the assertion XML
         with something unresolved. -->
    <Step>
        <Condition>isamjson.response.subjectId != null</Condition>
        <Name>AM-Coalesce-JSON-Metadata</Name>
    </Step>

    <Step>
        <Name>FC-Compress-Assertion</Name>
    </Step>
    <Step>
        <Name>FC-Set-SAML-Headers</Name>
    </Step>
</SharedFlow>
