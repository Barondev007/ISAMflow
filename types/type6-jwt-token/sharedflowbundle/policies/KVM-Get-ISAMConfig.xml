<KeyValueMapOperations name="KVM-Get-ISAMConfig" mapIdentifier="ISAM.JwtToken.Config">
    <DisplayName>KVM Get ISAM Config</DisplayName>
    <Scope>environment</Scope>
    <ExpiryTimeInSecs>300</ExpiryTimeInSecs>
    <!-- Type 6: JWT request, JWT-is-the-token response; no SAML assertion
         involved at all, so no compressSaml / trustedSigningCertThumbprints
         keys here (nothing to compress or verify an XML signature on). -->
    <Get assignTo="isam.config.host1"><Key><Parameter>isam.jwttoken.host1</Parameter></Key></Get>
    <Get assignTo="isam.config.host2"><Key><Parameter>isam.jwttoken.host2</Parameter></Key></Get>
    <Get assignTo="isam.config.port"><Key><Parameter>isam.jwttoken.port</Parameter></Key></Get>
    <Get assignTo="isam.config.scheme"><Key><Parameter>isam.jwttoken.scheme</Parameter></Key></Get>
    <Get assignTo="isam.config.path"><Key><Parameter>isam.jwttoken.path</Parameter></Key></Get>
    <Get assignTo="isam.config.connectTimeoutMs"><Key><Parameter>isam.jwttoken.connectTimeoutMs</Parameter></Key></Get>
    <Get assignTo="isam.config.ioTimeoutMs"><Key><Parameter>isam.jwttoken.ioTimeoutMs</Parameter></Key></Get>
    <Get assignTo="isam.config.appliesTo"><Key><Parameter>isam.jwttoken.appliesTo</Parameter></Key></Get>
    <Get assignTo="isam.config.tokenType"><Key><Parameter>isam.jwttoken.tokenType</Parameter></Key></Get>
    <Get assignTo="isam.config.keyType"><Key><Parameter>isam.jwttoken.keyType</Parameter></Key></Get>
    <Get assignTo="isam.config.requestType"><Key><Parameter>isam.jwttoken.requestType</Parameter></Key></Get>
</KeyValueMapOperations>
